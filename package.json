{
  "name": "to-maps",
  "version": "1.1.1",
  "description": "Tour Operators add-on for LSX",
  "scripts": {
    "build": "npm run build:js",
    "build:js": "terser assets/js/to-maps.js -c -m -o assets/js/to-maps.min.js",
    "build:pot": "wp i18n make-pot . languages/to-maps.pot",
    "build:po": "cp languages/to-maps.pot languages/to-maps-en_EN.po",
    "build:mo": "wp i18n make-mo languages",
    "build:lang": "npm run build:pot && npm run build:po && npm run build:mo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightspeedwp/to-maps.git"
  },
  "keywords": [
    "lsx",
    "addon"
  ],
  "author": "LightSpeed",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lightspeedwp/to-maps/issues"
  },
  "homepage": "https://github.com/lightspeedwp/to-maps#readme",
  "devDependencies": {
    "terser": "^5.51.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
